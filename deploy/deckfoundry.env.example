DECKFOUNDRY_BIND=127.0.0.1
DECKFOUNDRY_PORT=8080
DECKFOUNDRY_PROJECTS_DIR=/var/lib/deckfoundry/projects
# Enable behind an HTTPS reverse proxy:
DECKFOUNDRY_SECURE_COOKIE=1
# Set to the exact HTTPS origin when served through a reverse proxy.
# DECKFOUNDRY_ALLOWED_ORIGINS=https://deckfoundry.example
HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_MODEL=hermes-agent
HERMES_API_KEY=
